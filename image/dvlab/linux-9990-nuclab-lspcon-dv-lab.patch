+/*
+ * NUC Display Lab: put a VBT LSPCON into level-shifter mode through the
+ * standard DP dual-mode register (I2C 0x40 offset 0x40), the register
+ * intel_lspcon_init() uses for PCON mode. Like lspcon_probe(): wake the chip
+ * (it may be in D3 after an unbind), wait for it to identify, then retry.
+ */
+int intel_dp_lspcon_ls_lab_enter(struct intel_dp *intel_dp)
+{
+	struct intel_display *display = to_intel_display(intel_dp);
+	struct intel_digital_port *dig_port = dp_to_dig_port(intel_dp);
+	struct i2c_adapter *ddc = &intel_dp->aux.ddc;
+	enum drm_dp_dual_mode_type type = DRM_DP_DUAL_MODE_NONE;
+	enum drm_lspcon_mode cur = DRM_LSPCON_MODE_INVALID;
+	int i, err = -EIO;
+	u8 rev;
+
+	/* Already in LS mode: nothing to do (and no native AUX, which an
+	 * LSPCON in level-shifter mode does not answer). */
+	if (!drm_lspcon_get_mode(display->drm, ddc, &cur) && cur == DRM_LSPCON_MODE_LS)
+		return 0;
+
+	drm_dp_dpcd_read_byte(&intel_dp->aux, DP_DPCD_REV, &rev);	/* wake from D3 */
+	for (i = 0; i < 6; i++) {
+		type = drm_dp_dual_mode_detect(display->drm, ddc);
+		if (type == DRM_DP_DUAL_MODE_LSPCON)
+			break;
+		usleep_range(500, 1000);
+	}
+	if (!drm_lspcon_get_mode(display->drm, ddc, &cur) && cur == DRM_LSPCON_MODE_LS)
+		err = 0;
+	for (i = 0; i < 3 && err; i++)
+		err = drm_lspcon_set_mode(display->drm, ddc, DRM_LSPCON_MODE_LS, 1000);
+	drm_info(display->drm,
+		 "LSPCON LS lab: port %c adaptor %s, was %s, level-shifter mode %s (%d), HDMI DDC via %s\n",
+		 port_name(dig_port->base.port), drm_dp_get_dual_mode_type_name(type),
+		 cur == DRM_LSPCON_MODE_LS ? "LS" : cur == DRM_LSPCON_MODE_PCON ? "PCON" : "?",
+		 err ? "FAILED" : "set", err,
+		 display->params.lspcon_ls_lab == 2 ? "I2C-over-AUX" : "GMBUS");
+	return err;
+}
